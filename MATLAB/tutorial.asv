a=21 %[output:38acf87f]
b = a*2 %[output:7f52a8d9]
%comment

ex = exp(b) % e alla b %[output:47d2ab4f]

d = log(ex); % inverse of exp

fprintf('\n\n\n')

ver % versione di matlab %[output:734c0aba]

fprintf('\n\n\n')

c = physconst('LightSpeed') %[output:161a6b4c]
k = physconst('Boltzmann') %[output:09deeda4]

pi %[output:135ea994]

format long
pi %[output:23e4f1d2]

format short
pi %[output:8959ae10]

o = sqrt(-9) %[output:3fc0f25f]

p = cos(pi/4) %[output:049b2f84]

help atan2d %[output:175f0e9d]

q = round(atan2d(0.5,0.7)) %[output:4b8436d1]

% Verify that log(exp(b)) recovers b
isEqual = isequal(d, b) %[output:462d514e]

% Verify the inverse relationship within numerical precision
isApproximatelyEqual = abs(log(exp(b)) - b) < eps(b);

% Display verification results
isEqual %[output:6bdfe093]
disp(isApproximatelyEqual) %[output:3f4ec09a]

d, b %[output:6ad01b5f] %[output:6fc361a2]

s = "Hello World" %[output:4229f361]

save my_workspace b
clear d

clearvars

clc

u = [ 2  4  6 ] %row %[output:7ea4b714]
v = [ 1, 2, 3 ] %row %[output:390ff73e]
w = [ 5; 7; 9 ] %col %[output:37641c20]

z = 1:2:20 %start step end %[output:823e5f5c]
x = -2:-3:-30 %[output:342154eb]

tacche_intervallo = linspace(1,5,200) %[output:41dc99e2]

mat = [ 1 2; 3 4; 5 6; 7, 8] % 4x2 matrix %[output:4919f5c7]

x = linspace(0,4*pi,150) %[output:250ae0fd]
y = cos(x) %[output:09c51c72]


title("Grafico del segnale") %[output:131e1ea3]
xlabel("tempo") %[output:131e1ea3]
ylabel("Tensione") %[output:131e1ea3]

xlim([0,4*pi]) %[output:131e1ea3]
ylim([-1,1]) %[output:131e1ea3]

z = sin(x) %[output:9dcfb7d8]
plot(x,y) %[output:131e1ea3]
hold on % to stack on same plot and not create a different one %[output:131e1ea3]
plot(x,z) %[output:131e1ea3]
hold off % to put plots on new figure in the future %[output:131e1ea3]

x = 0:0.01:30 %[output:97980723]
plot3(cos(x),sin(x),x) %[output:6e377da2]
title("Spirale") %[output:6e377da2]
xlabel("coseno") %[output:6e377da2]
ylabel("seno") %[output:6e377da2]
zlabel("altezza") %[output:6e377da2]

x = linspace(-2,2,20)
y = x
[X,Y] = meshgrid(x,y)
Z = exp(-X.^2)

